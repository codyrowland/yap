{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yap",
  "version": "0.1.0",
  "identifier": "com.yap.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yap",
        "width": 960,
        "height": 600
      },
      {
        "label": "indicator",
        "url": "indicator.html",
        "title": "Recording",
        "width": 180,
        "height": 56,
        "x": 20,
        "y": 20,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "icon": []
  }
}
