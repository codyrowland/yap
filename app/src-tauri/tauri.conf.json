{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yap",
  "version": "0.2.3",
  "identifier": "com.yap.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Yap",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520
      },
      {
        "label": "overlay",
        "create": false,
        "url": "overlay.html",
