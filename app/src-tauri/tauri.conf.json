        "width": 440,
        "height": 56,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": true
      },
      {
        "label": "tray",
        "create": false,
        "url": "tray.html",
        "title": "Yap",
        "width": 320,
        "height": 470,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2NTdENzI1NDI1MjBFNEQKUldSTkRsSkNKZGRYVmdEUVlxeFBiRlRUUWxrUlNxT0tVeHA2dFh6aXdQUGVuUlRadTVJVHpuZ1cK",
      "endpoints": [
        "https://github.com/codyrowland/yap/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
