{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yap",
  "version": "0.1.0",
  "identifier": "com.yap.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yap",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Yap recording",
        "width": 440,
        "height": 56,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": true
      },
      {
        "label": "tray",
        "url": "tray.html",
        "title": "Yap",
        "width": 320,
        "height": 470,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/sherpa-onnx-c-api.dll": "sherpa-onnx-c-api.dll",
      "target/release/onnxruntime.dll": "onnxruntime.dll",
      "target/release/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
